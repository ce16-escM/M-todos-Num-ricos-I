        "##Guardamos valores iniciales\n",
        "p0=1.5  ##El punto medio de[1,2] lo defini como el p0\n",
        "tol=0.000001\n",
        "Nmax=100    #Num max de iteraciones\n",
        "error=100\n",
        "i=0  #Núm de iteraciones\n",
        "\n",
        "print(f\"         i       /         pi       /     g(pi)     /    Valor Absoluto(pi-pi-1)\\n\")\n",
        "while i<=Nmax:\n",
        "\n",
        "  print(f\"{i:.8f}      {pi:.8f}          {g(p0):.8f}           {error:.8f}\\n\")\n",
        "  pi=g(p0)  ##Evaluacion de los puntos en g\n",
        "\n",
        "  error=abs(pi-p0)\n",
        "\n",
        "  if error<tol:\n",
        "    print(f\"Solucion. La raiz de la ecuacion x^3+4x^2-10=0 ,es p=\",pi)\n",
        "    print(f\"El proceso fue exitoso\")\n",
        "    break\n",
        "\n",
        "\n",
        "  i=i+1\n",
        "  p0=pi\n",
        "\n",
        "\n",
        "else:\n",
        "  print(\"Proceso no exitoso\")"
